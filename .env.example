# Copy to .env before running anything: cp .env.example .env

# --- HydraDB connection ---
HYDRA_HTTP_URL=http://127.0.0.1:8443
HYDRA_BOLT_URL=neo4j://127.0.0.1:7687
HYDRA_ADMIN_URL=http://127.0.0.1:9090
HYDRA_AUTH_TOKEN=local-development-token-32-bytes
HYDRA_NAMESPACE=default
HYDRA_GRAPH=default
HYDRA_CELL_ID=cell-0

# --- Repository served by the workspace / MCP ---
# LUMOS_REPO=owner/name
# LUMOS_ROOT=/absolute/path/to/repository

# --- Container runtime ---
# The HydraDB image runs as UID/GID 10001 but bind-mounts host-owned directories,
# so the container must run as the host user. Set these to `id -u` and `id -g`.
HOST_UID=501
HOST_GID=20
